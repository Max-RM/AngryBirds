<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>AngryBirds</AssemblyName>
    <RootNamespace />
    <ApplicationId>AngryBirds</ApplicationId>
    <ApplicationDisplayVersion>1.5.3.0</ApplicationDisplayVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>Major</RollForward>
    <ApplicationIcon>..\tools\launcher\AngryBirds.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- .NET 8 SDK does not ship a native apphost for win-arm (ARM32). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Microsoft.Xna.Framework.RuntimeProfile" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.RuntimeProfile" LogicalName="Microsoft.Xna.Framework.RuntimeProfile" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PerformanceMeasuring\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\AngryBirds-v1.5.3.0.0_App\Content\**\*">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="AngryBirds.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AddSavesShortcuts" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Add-SavesShortcuts.ps1&quot; -OutDir &quot;$(TargetDir.TrimEnd('\'))&quot;" />
  </Target>

  <Target Name="AddSavesShortcutsToPublish" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\Add-SavesShortcuts.ps1&quot; -OutDir &quot;$(PublishDir.TrimEnd('\'))&quot;" />
  </Target>

  <!--
    SharpDX 4.0.1 pulls the .NET Core 2.1 Microsoft.NETCore.App metapackage into
    the dependency graph. When building/publishing with a RuntimeIdentifier the
    old host libraries land in the output and break the framework-dependent
    apphost (AngryBirds.exe cannot resolve CoreCLR). None of these files are
    needed for a framework-dependent app, so remove them right after output
    generation.
  -->
  <Target Name="RemoveNetCore21RuntimeJunk" AfterTargets="Build">
    <ItemGroup>
      <NetCore21Junk Include="$(TargetDir)hostfxr.dll;$(TargetDir)hostpolicy.dll;$(TargetDir)apphost.exe;$(TargetDir)dbgshim.dll;$(TargetDir)ucrtbase.dll;$(TargetDir)clrjit.dll;$(TargetDir)mscorrc*.dll;$(TargetDir)sos*.dll;$(TargetDir)SOS.NETCore.dll;$(TargetDir)mscordaccore*;$(TargetDir)api-ms-win-*.dll" />
    </ItemGroup>
    <Delete Files="@(NetCore21Junk)" />
  </Target>

  <Target Name="RemoveNetCore21RuntimeJunkFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <NetCore21Junk Include="$(PublishDir)hostfxr.dll;$(PublishDir)hostpolicy.dll;$(PublishDir)apphost.exe;$(PublishDir)dbgshim.dll;$(PublishDir)ucrtbase.dll;$(PublishDir)clrjit.dll;$(PublishDir)mscorrc*.dll;$(PublishDir)sos*.dll;$(PublishDir)SOS.NETCore.dll;$(PublishDir)mscordaccore*;$(PublishDir)api-ms-win-*.dll" />
    </ItemGroup>
    <Delete Files="@(NetCore21Junk)" />
  </Target>
</Project>
